<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="maze_compete">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>1 1</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <light name="sun" type="directional">
      <pose>0 0 30 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.4 0.5 -0.8</direction>
    </light>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.3979710577</latitude_deg>
      <longitude_deg>8.5461637398</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <!--
      NIDAR AirMouse competition-style course: 15 m x 15 m outer centreline
      rectangle with a 14.6 m x 14.6 m usable interior (x/y from -7.3 to +7.3).

      All walls are 0.4 m thick and 6 m high.

      Layout: five 2.6 m wide north-south corridors separated by four vertical
      dividers. Each divider has a doorway at one or both ends, plus optional
      mid-span doorways, so the arena is a looped serpentine rather than a
      perfect maze. Traversing every corridor requires four reversals of
      direction.

      Corridor centre lines (Gazebo ENU x): -6.0, -3.0, 0.0, +3.0, +6.0.
      A vehicle on any corridor centre line keeps 1.30 m to the nearest wall
      face, which is 0.98 m after the 0.32 m nominal envelope inflation.
    -->
    <model name="wall_outer_west"><static>true</static><pose>-7.5 0 3 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.4 15 6</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.4 15 6</size></box></geometry><material><ambient>0.28 0.32 0.38 1</ambient><diffuse>0.55 0.60 0.68 1</diffuse></material></visual></link></model>
    <model name="wall_outer_east"><static>true</static><pose>7.5 0 3 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.4 15 6</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.4 15 6</size></box></geometry><material><ambient>0.28 0.32 0.38 1</ambient><diffuse>0.55 0.60 0.68 1</diffuse></material></visual></link></model>
    <model name="wall_outer_south"><static>true</static><pose>0 -7.5 3 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>15 0.4 6</size></box></geometry></collision><visual name="visual"><geometry><box><size>15 0.4 6</size></box></geometry><material><ambient>0.28 0.32 0.38 1</ambient><diffuse>0.55 0.60 0.68 1</diffuse></material></visual></link></model>
    <model name="wall_outer_north"><static>true</static><pose>0 7.5 3 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>15 0.4 6</size></box></geometry></collision><visual name="visual"><geometry><box><size>15 0.4 6</size></box></geometry><material><ambient>0.28 0.32 0.38 1</ambient><diffuse>0.55 0.60 0.68 1</diffuse></material></visual></link></model>

    <!-- Divider 1 at x=-4.5: doorways at mid-span (y -1.7..+1.7) and north (y +4.3..+7.3). -->
    <model name="wall_v1a"><static>true</static><pose>-4.5 -4.6 3 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.4 5.8 6</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.4 5.8 6</size></box></geometry><material><ambient>0.28 0.32 0.38 1</ambient><diffuse>0.55 0.60 0.68 1</diffuse></material></visual></link></model>
    <model name="wall_v1b"><static>true</static><pose>-4.5 3.0 3 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.4 2.6 6</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.4 2.6 6</size></box></geometry><material><ambient>0.28 0.32 0.38 1</ambient><diffuse>0.55 0.60 0.68 1</diffuse></material></visual></link></model>

    <!-- Divider 2 at x=-1.5: doorways at south (y -7.3..-4.7) and north (y +4.3..+7.3). -->
    <model name="wall_v2"><static>true</static><pose>-1.5 -0.2 3 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.4 9.0 6</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.4 9.0 6</size></box></geometry><material><ambient>0.28 0.32 0.38 1</ambient><diffuse>0.55 0.60 0.68 1</diffuse></material></visual></link></model>

    <!-- Divider 3 at x=+1.5: doorways at mid-span (y -1.7..+1.7) and north (y +4.3..+7.3). -->
    <model name="wall_v3a"><static>true</static><pose>1.5 -4.6 3 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.4 5.8 6</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.4 5.8 6</size></box></geometry><material><ambient>0.28 0.32 0.38 1</ambient><diffuse>0.55 0.60 0.68 1</diffuse></material></visual></link></model>
    <model name="wall_v3b"><static>true</static><pose>1.5 3.0 3 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.4 2.6 6</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.4 2.6 6</size></box></geometry><material><ambient>0.28 0.32 0.38 1</ambient><diffuse>0.55 0.60 0.68 1</diffuse></material></visual></link></model>

    <!-- Divider 4 at x=+4.5: doorways at south (y -7.3..-4.7) and north (y +4.3..+7.3). -->
    <model name="wall_v4"><static>true</static><pose>4.5 -0.2 3 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.4 9.0 6</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.4 9.0 6</size></box></geometry><material><ambient>0.28 0.32 0.38 1</ambient><diffuse>0.55 0.60 0.68 1</diffuse></material></visual></link></model>

    <!-- Static, named survivor targets. These are visual proxies for the RGB/depth detector. -->
    <model name="survivor_01"><static>true</static><pose>-6.7 -3.0 0.45 0 0 0</pose><link name="link"><visual name="body"><geometry><cylinder><radius>0.28</radius><length>0.9</length></cylinder></geometry><material><ambient>0.85 0.10 0.08 1</ambient><diffuse>0.95 0.18 0.10 1</diffuse></material></visual><visual name="head"><pose>0 0 0.6 0 0 0</pose><geometry><sphere><radius>0.22</radius></sphere></geometry><material><ambient>0.95 0.75 0.35 1</ambient><diffuse>1 0.85 0.45 1</diffuse></material></visual></link></model>
    <model name="survivor_02"><static>true</static><pose>-5.3 3.0 0.45 0 0 0</pose><link name="link"><visual name="body"><geometry><cylinder><radius>0.28</radius><length>0.9</length></cylinder></geometry><material><ambient>0.85 0.10 0.08 1</ambient><diffuse>0.95 0.18 0.10 1</diffuse></material></visual><visual name="head"><pose>0 0 0.6 0 0 0</pose><geometry><sphere><radius>0.22</radius></sphere></geometry><material><ambient>0.95 0.75 0.35 1</ambient><diffuse>1 0.85 0.45 1</diffuse></material></visual></link></model>
    <model name="survivor_03"><static>true</static><pose>-3.7 -3.0 0.45 0 0 0</pose><link name="link"><visual name="body"><geometry><cylinder><radius>0.28</radius><length>0.9</length></cylinder></geometry><material><ambient>0.85 0.10 0.08 1</ambient><diffuse>0.95 0.18 0.10 1</diffuse></material></visual><visual name="head"><pose>0 0 0.6 0 0 0</pose><geometry><sphere><radius>0.22</radius></sphere></geometry><material><ambient>0.95 0.75 0.35 1</ambient><diffuse>1 0.85 0.45 1</diffuse></material></visual></link></model>
    <model name="survivor_04"><static>true</static><pose>0.7 3.0 0.45 0 0 0</pose><link name="link"><visual name="body"><geometry><cylinder><radius>0.28</radius><length>0.9</length></cylinder></geometry><material><ambient>0.85 0.10 0.08 1</ambient><diffuse>0.95 0.18 0.10 1</diffuse></material></visual><visual name="head"><pose>0 0 0.6 0 0 0</pose><geometry><sphere><radius>0.22</radius></sphere></geometry><material><ambient>0.95 0.75 0.35 1</ambient><diffuse>1 0.85 0.45 1</diffuse></material></visual></link></model>
    <model name="survivor_05"><static>true</static><pose>2.3 -3.0 0.45 0 0 0</pose><link name="link"><visual name="body"><geometry><cylinder><radius>0.28</radius><length>0.9</length></cylinder></geometry><material><ambient>0.85 0.10 0.08 1</ambient><diffuse>0.95 0.18 0.10 1</diffuse></material></visual><visual name="head"><pose>0 0 0.6 0 0 0</pose><geometry><sphere><radius>0.22</radius></sphere></geometry><material><ambient>0.95 0.75 0.35 1</ambient><diffuse>1 0.85 0.45 1</diffuse></material></visual></link></model>
    <model name="survivor_06"><static>true</static><pose>6.7 3.0 0.45 0 0 0</pose><link name="link"><visual name="body"><geometry><cylinder><radius>0.28</radius><length>0.9</length></cylinder></geometry><material><ambient>0.85 0.10 0.08 1</ambient><diffuse>0.95 0.18 0.10 1</diffuse></material></visual><visual name="head"><pose>0 0 0.6 0 0 0</pose><geometry><sphere><radius>0.22</radius></sphere></geometry><material><ambient>0.95 0.75 0.35 1</ambient><diffuse>1 0.85 0.45 1</diffuse></material></visual></link></model>
  </world>
</sdf>
