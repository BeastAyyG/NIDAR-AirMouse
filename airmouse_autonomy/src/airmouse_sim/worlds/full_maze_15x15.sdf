<?xml version="1.0"?>
<!--
  AirMouse scenario world: full_maze_15x15
  15x15 m maze: main corridor, three rooms with doors, central hall and a
  split top band.  Six survivor markers plus a green exit beacon.

  Frame: Gazebo ENU (x forward, y left, z up), metres.
  Arena walls: 0.2 m thick, 2.0 m high.  Drone spawns at (1, 1, 0.5).
  Sensors: RGB-D sensor topic "camera" (gz /camera/...) and IMU topic
  "imu" (gz /imu); see airmouse_sensors/config/gz_bridge.yaml and
  airmouse_sensors/README.md.  PX4 SITL is launched separately.
  Survivor markers are static cylinders survivor_1..survivor_N (max 6).
-->
<sdf version="1.10">
  <world name="full_maze_15x15">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <!-- Ground plane (inline, no fuel/model:// dependency). -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.30 0.30 0.30 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <!-- AirMouse X500 with RGB-D + IMU (spawn pose is fixed by contract). -->
    <include>
      <uri>model://airmouse_x500_rgbd</uri>
      <name>airmouse</name>
      <pose>1 1 0.5 0 0 0</pose>
    </include>
    <model name="wall_south">
      <static>true</static>
      <pose>7.5 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>15.2 0.2 2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>15.2 0.2 2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.68 0.68 0.68 1</diffuse>
          </material>
        </visual>
      </link>
