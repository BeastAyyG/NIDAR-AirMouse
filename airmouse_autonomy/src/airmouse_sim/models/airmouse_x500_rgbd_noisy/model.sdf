<?xml version="1.0"?>
<!--
  AirMouse X500 RGB-D - NOISY variant for robustness testing.

  Identical kinematics and sensor layout to model://airmouse_x500_rgbd, with
  deliberately degraded sensing:

    * Camera noise stddev raised from 0.007 to 0.03 (metres for depth,
      normalised intensity units for colour).  Gazebo's rgbd_camera applies
      its authored <noise> model to both the colour and the depth buffer, so
      this is the "larger depth noise" authoring knob.
    * Dropped-frame emulation (10%): frame dropping is necessarily a RUNTIME
      behaviour (a sensor cannot author its own dropouts in SDF).  The
      scenario is emulated on the consumer side by discarding one in ten
      incoming frames in the perception pipeline, wired at runtime through
      the perception node's drop-rate parameter.  Nothing in this model
      enables a drop plugin; noise is the authored part.

  Used by worlds/noisy_depth.sdf.  Do not use for the nominal mission.
-->
<sdf version="1.10">
  <model name="airmouse_x500_rgbd_noisy">
    <static>false</static>
    <self_collide>false</self_collide>

    <link name="base_link">
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.012083</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.012083</iyy>
          <iyz>0</iyz>
          <izz>0.020833</izz>
        </inertia>
      </inertial>

      <visual name="body_visual">
        <geometry>
          <box>
            <size>0.4 0.4 0.12</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.20 0.20 0.20 1</diffuse>
          <specular>0.10 0.10 0.10 1</specular>
        </material>
      </visual>

      <collision name="body_collision">
        <geometry>
          <box>
            <size>0.4 0.4 0.12</size>
          </box>
        </geometry>
      </collision>

      <!-- IMU on the body centre; gaussian noise on both rate and accel. -->
      <sensor name="imu" type="imu">
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <topic>imu</topic>
        <gz_frame_id>base_link</gz_frame_id>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.002</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.002</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.002</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.02</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.02</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.02</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>

    <!-- Four rotor arms; visuals only (fixed joints keep them attached). -->
    <link name="rotor_0">
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.000225</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000225</iyy>
          <iyz>0</iyz>
          <izz>0.00045</izz>
        </inertia>
      </inertial>
      <pose>0.22 0.22 0.02 0 0 0</pose>
      <visual name="rotor_visual">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.9 0.45 0.05 1</ambient>
          <diffuse>0.95 0.55 0.10 1</diffuse>
        </material>
      </visual>
      <collision name="rotor_collision">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <link name="rotor_1">
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.000225</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000225</iyy>
          <iyz>0</iyz>
          <izz>0.00045</izz>
        </inertia>
      </inertial>
      <pose>-0.22 0.22 0.02 0 0 0</pose>
      <visual name="rotor_visual">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.9 0.45 0.05 1</ambient>
          <diffuse>0.95 0.55 0.10 1</diffuse>
        </material>
      </visual>
      <collision name="rotor_collision">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <link name="rotor_2">
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.000225</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000225</iyy>
          <iyz>0</iyz>
          <izz>0.00045</izz>
        </inertia>
      </inertial>
      <pose>-0.22 -0.22 0.02 0 0 0</pose>
      <visual name="rotor_visual">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.9 0.45 0.05 1</ambient>
          <diffuse>0.95 0.55 0.10 1</diffuse>
        </material>
      </visual>
      <collision name="rotor_collision">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <link name="rotor_3">
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.000225</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000225</iyy>
          <iyz>0</iyz>
          <izz>0.00045</izz>
        </inertia>
      </inertial>
      <pose>0.22 -0.22 0.02 0 0 0</pose>
      <visual name="rotor_visual">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.9 0.45 0.05 1</ambient>
          <diffuse>0.95 0.55 0.10 1</diffuse>
        </material>
      </visual>
      <collision name="rotor_collision">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <link name="camera_link">
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00002</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00003</iyy>
          <iyz>0</iyz>
          <izz>0.00003</izz>
        </inertia>
      </inertial>
      <pose>0.16 0 0.02 0 0 0</pose>
      <visual name="camera_body_visual">
        <geometry>
          <box>
            <size>0.06 0.09 0.05</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.25 1</ambient>
          <diffuse>0.10 0.10 0.40 1</diffuse>
        </material>
      </visual>
      <collision name="camera_body_collision">
        <geometry>
          <box>
            <size>0.06 0.09 0.05</size>
          </box>
        </geometry>
      </collision>

      <!-- RGB-D: colour + depth + camera_info + points in one sensor. -->
      <sensor name="camera" type="rgbd_camera">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>20</update_rate>
        <topic>camera</topic>
        <gz_frame_id>camera_link</gz_frame_id>
        <camera>
          <horizontal_fov>1.2</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.2</near>
            <far>8.0</far>
          </clip>
          <depth_camera>
            <clip>
              <near>0.2</near>
              <far>8.0</far>
            </clip>
          </depth_camera>
          <!-- Noisy variant: 0.03 stddev (vs 0.007 nominal). -->
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.03</stddev>
          </noise>
        </camera>
      </sensor>
    </link>

    <joint name="rotor_0_joint" type="fixed">
      <parent>base_link</parent>
      <child>rotor_0</child>
    </joint>
    <joint name="rotor_1_joint" type="fixed">
      <parent>base_link</parent>
      <child>rotor_1</child>
    </joint>
    <joint name="rotor_2_joint" type="fixed">
      <parent>base_link</parent>
      <child>rotor_2</child>
    </joint>
    <joint name="rotor_3_joint" type="fixed">
      <parent>base_link</parent>
      <child>rotor_3</child>
    </joint>
    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>
  </model>
</sdf>
