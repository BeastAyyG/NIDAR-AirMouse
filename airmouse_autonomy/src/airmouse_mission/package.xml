<?xml version="1.0"?>
<package format="3">
  <name>airmouse_mission</name>
  <version>0.1.0</version>
  <description>
    Mission monitoring and failsafe FSM for the AirMouse autonomy stack:
    coverage/region status, prioritized findings, mission report, and
    EXPLORE/RETURN/LAND/HOLD/FAILSAFE/DONE state machine. Cores are
    ROS-independent; rclpy adapter ships in the runtime wave.
  </description>
  <maintainer email="dev@local">airmouse</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>airmouse_interfaces</exec_depend>
  <exec_depend>airmouse_mapping</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- px4_msgs comes from the existing PX4 workspace (no new third-party code). -->
  <exec_depend>px4_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>