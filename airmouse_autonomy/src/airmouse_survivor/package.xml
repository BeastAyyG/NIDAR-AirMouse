<?xml version="1.0"?>
<package format="3">
  <name>airmouse_survivor</name>
  <version>0.1.0</version>
  <description>
    Survivor detection and tracking for the AirMouse autonomy stack:
    spatial-gate dedup tracker, sim target detector, YOLO placeholder.
    Cores are ROS-independent; rclpy adapter ships in the runtime wave.
  </description>
  <maintainer email="dev@local">airmouse</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>airmouse_interfaces</exec_depend>
  <exec_depend>airmouse_perception</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>